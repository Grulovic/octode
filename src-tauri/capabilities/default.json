{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace",
  "description": "Local workspace windows and native folder selection",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm"
  ]
}
